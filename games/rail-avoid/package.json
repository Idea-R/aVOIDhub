{
  "name": "@avoid/rail-avoid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RAILaVOID - a moving-train logistics and tower-defense roguelite by aVOID Games",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "node verify/verify.mjs",
    "typecheck": "tsc --noEmit",
    "build:standalone": "node scripts/standalone.mjs",
    "check:standalone": "node verify/standalone-check.mjs",
    "verify:hud": "node verify/hud-sprint-check.mjs",
    "verify:inspector": "node verify/inspector-pan-check.mjs",
    "verify:usability": "node verify/usability-check.mjs",
    "verify:junction": "node verify/junction-direction-check.mjs",
    "verify:responsive": "node verify/map-first-check.mjs",
    "verify:route-overlay": "node verify/route-overlay-check.mjs",
    "verify:crew-timing": "node verify/crew-timing-check.mjs",
    "verify:expedition-cards": "node verify/expedition-cards-check.mjs",
    "verify:continuity": "node verify/continuity-check.mjs",
    "verify:conversation": "node verify/conversation-check.mjs",
    "verify:dialogue-shortcuts": "node verify/dialogue-shortcuts-check.mjs",
    "verify:combat-readability": "node verify/combat-readability-check.mjs",
    "verify:blocked-track": "node verify/blocked-track-check.mjs",
    "verify:expedition": "node verify/expedition-art-check.mjs",
    "verify:avatars": "node verify/native-avatar-check.mjs",
    "perf:headed": "node verify/perf-headed.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.0",
    "@fontsource/special-elite": "^5.2.0",
    "gsap": "^3.15.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
